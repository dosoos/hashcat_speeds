# Copy this file to .dev.vars for local development (`wrangler dev`).
# .dev.vars is git-ignored. NEVER commit real tokens.

# GitHub Personal Access Token with Contents read/write on the target repo.
# Fine-grained PAT: select the repo, permission "Contents" = Read and write.
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxxxxxx"

# Cloudflare Turnstile secret key. REQUIRED.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Add your frontend origin (e.g. https://dosoos.github.io) to its allowed hostnames.
TURNSTILE_SECRET = "0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
